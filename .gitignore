.vscode/

# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Custom

# Local media output and scratch download folders. Anchored to the repo root on
# purpose: an unanchored `downloads/` also matches `tests/downloads/`, hiding
# its tracked test modules from rg, editors and review tooling (TT-04).
/download/
/downloads/

# Local design mockups (not part of the shipped app)
mockups/

# Local scratch / working files (not part of the shipped app)
scratchpad/

# Deferred distribution channels (kept local until each venue actually launches)
packaging/aur/
packaging/winget/

# Local audit / review reports (working notes, never part of the shipped app).
# Root-scoped on purpose: the tracked tests/ files that mention "audit" in their
# names are real source and must stay tracked. release.sh publishes the tree of
# a ref, so untracked files were already safe from the public repo; this closes
# the other door, a stray `git add -A` sweeping one into a commit.
/*audit*.md

# macOS Finder metadata and the local Apple cookies export used for manual
# download tests: machine-local, never part of the repo.
.DS_Store
cookies.txt

# Apple Music APK/.apkm bundles (maintainer-local, proprietary Apple binaries):
# the setup wizard and image builds read them from disk, they must never be
# committed.
*.apk
*.apkm
*.apks

# QML/JS compile caches (qmllint, the QML engine) land next to sources; the
# Flatpak build tree lands at the repo root (packaging/flatpak/README.md).
*.jsc
*.qmlc
/build-dir/
/flatpak-repo/
# Added by code-review-graph
.code-review-graph/
